{
  "name": "razorpay-freshdesk-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only Freshdesk MCP connector with authenticated synthetic demonstration",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test --test-reporter=spec dist/test/*.test.js",
    "demo": "npm run build && node dist/demo/run.js",
    "verify": "npm run typecheck && npm test && npm run demo",
    "tools:export": "npm run build && node dist/scripts/export-tools.js",
    "check:live": "npm run build && node dist/scripts/check-live.js",
    "package:submission": "node scripts/package-submission.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
